---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	draft_plan(draft_plan)
	add_risk_rules(add_risk_rules)
	add_invalidation(add_invalidation)
	__end__([<p>__end__</p>]):::last
	__start__ --> draft_plan;
	add_risk_rules --> add_invalidation;
	draft_plan -. &nbsp;Pass&nbsp; .-> __end__;
	draft_plan -. &nbsp;Fail&nbsp; .-> add_risk_rules;
	add_invalidation --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
